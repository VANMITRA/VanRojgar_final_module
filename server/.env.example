NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vanrozgar?retryWrites=true&w=majority
LOG_LEVEL=info
GIT_SHA=local-dev
CORS_ORIGINS=
JWT_SECRET=replace-with-your-strong-random-jwt-secret-minimum-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_COST=10
BULK_THRESHOLDS={"mass_kg":50,"volume_l":50,"count":100}
ALLOW_VILLAGER_LISTINGS=true
RATE_LIMIT_LOGIN=30/15m
RATE_LIMIT_SEARCH=120/1m
DELIVERY_RATE_PAISE_PER_KM=1200
SEED_DEMO_PASSWORD=ReplaceWithStrongDemoPassword123
SEED_TEAM_PASSWORD=ReplaceWithStrongAdminPassword123
# The team UPI ID for buyers' UPI payments (name@bank). Leave empty to switch UPI off. Never commit the real one.
UPI_ID=
UPI_PAYEE_NAME=VanRozgar

# --- Local run WITHOUT installing/starting MongoDB ---
# Run `npm run dev:local` (or `npm run start:local`). The API starts its own MongoDB, keeps data in
# server/.data, and seeds the 10 pilot villages on first start. MONGODB_URI is ignored in this mode.
# The first run downloads the MongoDB binary once (about 200 MB), so it needs internet that time only.
