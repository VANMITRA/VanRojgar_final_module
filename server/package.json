{
  "name": "vanrozgar-server",
  "version": "0.1.0",
  "description": "VanRozgar REST API for Community Forest Resource marketplace",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:local": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/**/*.test.js",
    "seed": "node src/seed/run.js",
    "import:cfr": "node scripts/import_cfr.js",
    "indexes": "node scripts/indexes.js",
    "smoke": "node scripts/smoke.js",
    "dev:local": "node --watch src/server.js --embedded-db",
    "start:local": "node src/server.js --embedded-db"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^8.10.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
