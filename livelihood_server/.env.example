# The livelihood server (Python). Copy to .env. Never commit .env.

VANMITRA_ENV=development

# The SAME database and the SAME secret as the Node server (server/.env), so one sign-in works for both.
VANMITRA_MONGODB_URI=mongodb://127.0.0.1:27017/vanrozgar
VANMITRA_MONGODB_DB=vanrozgar
VANMITRA_JWT_SECRET=change-me-to-the-same-long-secret-as-the-node-server
VANMITRA_USERS_COLLECTION=users

# "mongo" in the integrated app; "memory" for tests and quick experiments
VANMITRA_LIVELIHOOD_STORE=mongo
# development only: built-in users and tokens (refused when VANMITRA_ENV=production)
VANMITRA_LIVELIHOOD_DEV_USERS=false
